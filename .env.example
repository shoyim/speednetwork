# Copy to .env and fill in your values

# Server region label (displayed in UI)
REGION=us-east-1

# Allowed CORS origin for backend (use * in dev)
ALLOWED_ORIGIN=*

# Public WebSocket URL (browser connects to this)
# In production: wss://yourdomain.com
# Leave empty for auto-detection from browser URL
NEXT_PUBLIC_WS_URL=

# Port for Nginx (default 80)
HTTP_PORT=80
